# Immich 相册集成
# /gallery 页面会在构建时从 Immich 拉取相册数据，并将略缩图 URL 拼接到 <img src> 中。
# 注意：API key 会以查询参数形式出现在生成的静态 HTML 中，请使用只读 / 范围最小的 key。
IMMICH_API_URL=https://api.mahoo12138.cn/immich
IMMICH_API_KEY=
IMMICH_ALBUM_NAME=测试相册

# 高德地图（/travel 页面用）
# key 需要在 https://console.amap.com/dev/key/app 申请，并将站点域名加入白名单
# 注意：作为 PUBLIC_ 变量会出现在生成的静态 HTML 中，请勾选 Web 端 (JS API) 类型，并在控制台配置域名白名单
PUBLIC_AMAP_KEY=
# 如果在控制台为 key 启用了"安全密钥"，请填写；否则留空
PUBLIC_AMAP_SECURITY_CODE=

# Artalk 评论系统（自建 client，直接调用后端 /api/v2，不加载官方 SDK UI）
# 默认值已内置：ARTALK_SERVER=https://artalk.mahoo12138.cn
#                ARTALK_SITE=Mahoo Space（后端「站点管理」里注册的名字，必须完全一致）
# 两者都为空时用默认值；设 ARTALK_DISABLED=1 可临时关闭评论区。
ARTALK_SERVER=
ARTALK_SITE=

# 可选：每页评论数、嵌套层数、空评论文案、输入框占位符、请求超时(ms)
ARTALK_PAGE_SIZE=20
ARTALK_NEST_MAX=2
ARTALK_NO_COMMENT=
ARTALK_PLACEHOLDER=
ARTALK_TIMEOUT=15000

# 可选：表情来源。auto=跟随后端 /conf 并在失败时回退内置 Unicode 表情（默认）
# builtin=只用内置、false=关闭、或填一个表情包 JSON 的完整 URL
ARTALK_EMOTICONS=auto

# 本地开发：后端 CORS 只放行线上域名，dev 默认把请求代理到同源 /artalk-api。
# 设 0 关闭代理（此时需把 http://localhost:4321 加进 Artalk 可信域名），
# 或填自定义前缀；astro.config.mjs 会读取同一个值，无需改两处。
ARTALK_DEV_PROXY=

# Umami 网站统计
# 在所有页面 <head> 注入 Umami 跟踪脚本。两项均为必填，缺一则不注入。
# UMAMI_HOST:       Umami 实例地址（不含末尾斜杠），例如 https://umami.example.com
# UMAMI_WEBSITE_ID: Umami 后台「网站设置」里的 Website ID（UUID）
UMAMI_HOST=
UMAMI_WEBSITE_ID=
