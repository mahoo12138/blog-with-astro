---
import BaseHead from '../components/BaseHead.astro';
import SkipLink from '../components/SkipLink.astro';
import TopProgressBar from '../components/TopProgressBar.astro';
import * as styles from './BlankShell.css';

interface Props {
	title: string;
	description: string;
	lang?: string;
	noindex?: boolean;
	/** 页面级字体样式表（如 /love 的衬线字体），全站默认不加载 */
	extraFonts?: string[];
}

const { title, description, lang = 'zh-CN', noindex = false, extraFonts } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} noindex={noindex} extraFonts={extraFonts} />
	</head>
	<body class={styles.body}>
		<TopProgressBar />
		<SkipLink />
		<main id="main-content" class={styles.main} data-pagefind-ignore tabindex="-1">
			<slot />
		</main>
	</body>
</html>
