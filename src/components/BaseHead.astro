---
import '../styles/theme.css.ts';
import '../styles/themes/index.css';
import { appearanceStorageKeys, colorSchemeIds } from '../config/appearance';
// 代码块外壳（语言标签 + 复制按钮）样式。
// 放在 BaseHead 是因为代码块可能出现在任何渲染 Markdown 的页面，
// 这里是全站唯一的公共入口，能保证样式一定被引入。
import '../styles/codeBlock.css.ts';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/avatar.png';
import { SITE_AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { ClientRouter } from 'astro:transitions';
import UmamiAnalytics from './UmamiAnalytics.astro';
import { siteFontConfig } from '../config/fonts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	/** 功能页 / 内部预览页用，输出 robots noindex 阻止收录 */
	noindex?: boolean;
	/**
	 * 额外的字体样式表 URL（页面级按需）。
	 * 全站只加载 mono 字体；像 /love 这种独立设计语言的页面要衬线字体时，
	 * 传 `[siteFontConfig.serifFontsUrl]` 自行引入，不要退回全局。
	 */
	extraFonts?: string[];
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// 未显式传图时的 og:image 兜底。源 avatar.png 为 1056×992 / 738KB 的 PNG，
// 直接把原图 URL 塞进 og:image 会让社交平台抓取端白白下载 738KB。
// 这里走图片管线压成 512px 宽的 JPEG（约 40KB），兼容性也优于 webp。
const fallbackOgImage = await getImage({ src: FallbackImage, width: 512, format: 'jpeg' });

const { title, description, image = fallbackOgImage, type = 'website', publishedTime, modifiedTime, noindex = false, extraFonts = [] } = Astro.props;

// og:image 既支持本地 ImageMetadata，也支持远程 URL 字符串
const ogImage = typeof image === 'string' ? new URL(image, Astro.url) : new URL(image.src, Astro.url);

const websiteJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	description: SITE_DESCRIPTION,
	url: Astro.site?.toString(),
	author: { '@type': 'Person', name: SITE_AUTHOR },
};

const safeStringify = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<ClientRouter />

<!-- 在首次绘制前恢复配色；后续导航由统一 appearance 控制器保留内存状态。 -->
<script is:inline define:vars={{ appearanceStorageKeys, colorSchemeIds }}>
	(() => {
		if (window.__appearanceBootstrapped) return;
		window.__appearanceBootstrapped = true;
		const root = document.documentElement;
		let mode = 'system', scheme = 'blog';
		try {
			const savedMode = localStorage.getItem(appearanceStorageKeys.mode);
			const savedScheme = localStorage.getItem(appearanceStorageKeys.scheme);
			if (savedMode === 'light' || savedMode === 'dark') mode = savedMode;
			if (colorSchemeIds.includes(savedScheme)) scheme = savedScheme;
		} catch {}
		if (mode !== 'system') root.dataset.theme = mode;
		else root.removeAttribute('data-theme');
		if (scheme !== 'blog') { root.dataset.colorScheme = scheme; root.classList.add(`theme-${scheme}`); }
		else root.removeAttribute('data-color-scheme');
		root.classList.toggle('dark', mode === 'dark' || (mode === 'system' && matchMedia('(prefers-color-scheme: dark)').matches));
		// has-js 也在这里打上：代码块的复制按钮与「超高折叠」两处样式都挂在
		// `html.has-js` 下（无 JS 时不裁剪、不显示无效控件）。放到首屏内联脚本里
		// 而不是等 defer 的 code-copy.js，是为了让折叠在**第一帧**就生效，
		// 否则长代码会先整段摊开、脚本跑完再刷地收起来。
		root.classList.add('has-js');
	})();
</script>
<script>
	import '../scripts/appearance';
</script>

<!-- 字体加载策略（2026-11 调整：中文改用系统字体栈）
     全站只加载 JetBrains Mono（拉丁字形、15KB CSS）；中文走系统栈，
     不再引入 Noto Sans/Serif SC 的 unicode-range 分包 CSS。
     原因见 src/config/fonts.ts 顶部注释与 docs/perf-fix-font-2026-11-05.md：
       1) 中文 webfont CSS 每页 182KB，占首页总传输 63%；
       2) 分包渐进到达 + 无 size-adjust → 换字体时整页重排，长文 CLS 0.250；
       3) fonts.googleapis.com 在大陆不可达，中文读者只能等超时。

     仍保留 media="print" + onload 的异步化：mono 字体虽小，但同样不该
     阻塞首次渲染（代码块的字体抖动比正文轻，不值得为它排队）。
     需要衬线的独立页面（/love）通过 extraFonts 自行引入 serifFontsUrl。 -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	rel="stylesheet"
	href={siteFontConfig.googleFontsUrl}
	media="print"
	onload="this.media='all'"
/>
<noscript>
	<link rel="stylesheet" href={siteFontConfig.googleFontsUrl} />
</noscript>
{extraFonts.map((href) => <link rel="stylesheet" href={href} />)}

{/* 公共交互脚本（都是 defer，执行时机在 DOM 解析完之后，不阻塞首屏）。
    两个脚本都走外部静态文件而不是 is:inline：实测 code-copy.js 内联版
    4.86KB × 236 页 = 1.09MB，而其中很多页根本用不上；外部文件全站只下载
    一次并可被浏览器缓存。top-progress.js 同理（它是全站每页都要用，
    内联就是纯重复）。

    一次并可被浏览器缓存。

    代码块复制按钮：
    defer 保证在 DOM 就绪后执行，不阻塞解析。
    无 JS 时按钮不可用，其隐藏逻辑放在 codeBlock.css.ts 里用
    html.no-js 兜底（见该文件注释）。 */}
<script src="/js/top-progress.js" defer></script>
<script src="/js/code-copy.js" defer></script>
{/* 超高代码块的折叠栏：构建期只做估算，这里按真实排版复核一遍
    （详见 public/js/code-block-fold.js 顶部注释）。 */}
<script src="/js/code-block-fold.js" defer></script>

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{type === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />

<!-- JSON-LD: WebSite -->
<script is:inline type="application/ld+json" set:html={safeStringify(websiteJsonLd)} />

<UmamiAnalytics />
