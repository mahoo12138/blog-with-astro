---
import { resolveMedia } from '../../utils/media.mjs';

interface Props {
	src: string;
	alt?: string;
	type?: 'blur' | 'watermark';
	brand?: string;
	logo?: string;
	model?: string;
	focal?: string;
	aperture?: string;
	shutter?: string;
	iso?: string;
	datetime?: string;
}

const { src, alt = '', type = 'blur', brand, logo, model, focal, aperture, shutter, iso, datetime } = Astro.props;
const exif = [focal, aperture, shutter, iso].filter(Boolean).join(' ');
const logoText = logo ?? brand;
// 三层来源统一解析；模糊背景用同一张图，别让两处各写一份地址
const media = resolveMedia(src);
---

<figure class="tag-plugin photo" data-type={type}>
	{type === 'blur' && <div class="photo-bg" style={`background-image:url("${media.src}");`}></div>}
	<div class="photo-image-wrap">
		<img class="photo-image" src={media.src} alt={alt} loading="lazy" decoding="async" data-media={media.kind} />
	</div>
	<div class="photo-bar">
		<div class="photo-left">
			{brand && <div class="photo-brand">{brand}</div>}
			{model && <div>{model}</div>}
		</div>
		<div class="photo-center">{logoText}</div>
		<div class="photo-right">
			{exif && <div>{exif}</div>}
			{datetime && <div>{datetime}</div>}
		</div>
	</div>
</figure>