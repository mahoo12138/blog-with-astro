---
/**
 * ArtalkComments —— 站点自建的 Artalk 评论区（替代官方 SDK 的 UI）。
 *
 * 集成方式：SSR 只输出配置 data-* 与两行骨架，浏览器侧由
 * `./comments/client.ts` 注入完整界面（裸 <script>，进入视口 600px 才发请求）。
 * 挂载点保持不变：BlogPost.astro 与 about.astro 仍按原样传 pageKey / pageTitle。
 *
 * 把完整表单放进共享 JS chunk 而不是 128 份 HTML：评论区挂在所有文章页，
 * 每页复制 3.4KB 表单会让 dist 多出 ~430KB，直接顶破 audit:dist 的 22MB 预算。
 *
 * 配置真源是 src/config/comments.ts；默认值已指向
 * https://artalk.mahoo12138.cn/ 与站点名 "Mahoo Space"，可用 .env 覆盖。
 * `mode="counts"` 只输出一个隐藏配置节点，用于列表页批量补全
 * `<span data-comment-count="/post/x/"></span>` 的评论数。
 */
import { commentsConfig } from '../config/comments';
import * as css from './comments/comments.css';

interface Props {
	pageKey?: string;
	pageTitle?: string;
	mode?: 'full' | 'counts';
}

const { pageKey, pageTitle, mode = 'full' } = Astro.props;
const enabled = commentsConfig.enabled;
const key = pageKey ?? Astro.url.pathname;
---

{enabled && mode === 'counts' && (
	<div
		hidden
		data-pagefind-ignore
		data-comments-root
		data-mode="counts"
		data-server={commentsConfig.apiBase}
		data-site={commentsConfig.site}
		data-page-key={key}
		data-page-title={pageTitle ?? ''}
		data-timeout={commentsConfig.timeout}
	></div>
)}

{enabled && mode === 'full' && (
	<section
		class={css.section}
		data-pagefind-ignore
		data-comments-root
		data-mode="full"
		data-server={commentsConfig.apiBase}
		data-site={commentsConfig.site}
		data-page-key={key}
		data-page-title={pageTitle ?? ''}
		data-page-size={commentsConfig.pageSize}
		data-nest-max={commentsConfig.nestMax}
		data-emoticons={commentsConfig.emoticons === false ? 'false' : commentsConfig.emoticons}
		data-no-comment={commentsConfig.noComment}
		data-placeholder={commentsConfig.placeholder}
		data-timeout={commentsConfig.timeout}
		aria-label="评论区"
	>
		<div class={css.list} data-role="list" aria-busy="true" aria-live="polite">
			<div class={css.skeletonRow} aria-hidden="true">
				<div class={css.skeletonAvatar}></div>
				<div class={css.skeletonBody}>
					<div class={css.skeletonLine} style="width:38%"></div>
					<div class={css.skeletonLine} style="width:92%"></div>
					<div class={css.skeletonLine} style="width:70%"></div>
				</div>
			</div>
			<div class={css.skeletonRow} aria-hidden="true">
				<div class={css.skeletonAvatar}></div>
				<div class={css.skeletonBody}>
					<div class={css.skeletonLine} style="width:28%"></div>
					<div class={css.skeletonLine} style="width:86%"></div>
				</div>
			</div>
		</div>
	</section>
)}

<script>
	// 裸 script（不带任何属性）：由 Vite 打包，内部 TS import 才能正常运行。
	// 自执行 + astro:page-load 重挂、astro:before-swap 销毁的逻辑都在 client.ts 里。
	import './comments/client';
</script>
